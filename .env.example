# ─────────────────────────────────────────────────────────────
# Saathi — environment
# Everything below is optional. Saathi answers from its verified
# corpus with no keys, no cost and no network call.
# ─────────────────────────────────────────────────────────────

# Which generator writes prose around the retrieved law.
# extractive | lora | groq | openrouter | gemini
SAATHI_MODEL_PROVIDER=extractive

# ── 1. Your own fine-tuned LoRA, served free (recommended) ──
# vLLM / Ollama / llama.cpp exposing an OpenAI-compatible
# /v1/chat/completions. scripts/serve_lora.sh starts vLLM;
# scripts/lora_proxy.py adds a token and a rate limit if you
# publish it through a tunnel.
SAATHI_LORA_BASE_URL=http://127.0.0.1:8000/v1
SAATHI_LORA_MODEL=saathi-lora
SAATHI_LORA_TOKEN=

# ── 2. Or a free-tier public API ──
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
SAATHI_GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
SAATHI_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
SAATHI_GEMINI_MODEL=gemini-2.0-flash

# ── Law sync and operator console ──
# Shared secret for POST /api/sync and /admin. Must be at least
# 12 characters and must not be the placeholder, or both stay locked.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SAATHI_SYNC_TOKEN=dev-only-change-me
# Optional. data.gov.in issues one free per account.
DATA_GOV_IN_API_KEY=
SAATHI_INDIA_CODE_OFFICIAL=https://www.indiacode.nic.in

# ── Storage ──
# Local dev uses node:sqlite (built into Node 22+).
SAATHI_DB_PATH=
